# ==============================================================================
# tg-cli Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env
#
# Obtain TG_API_ID and TG_API_HASH at: https://my.telegram.org (API development tools)
# ==============================================================================

# [Required for Live Mode] Telegram API Credentials
TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef

# [Optional] Google Gemini API Key for on-demand voice message transcription ('t' key)
# you can put several gemini keys, in free tiers from different accounts to rotate between them and avoid rate limiting
GEMINI_API_KEY1=YourGeminiApiKey1Here
GEMINI_API_KEY2=YourGeminiApiKey2Here
GEMINI_API_KEY3=YourGeminiApiKey3Here
# [Optional] Proxy Configuration (SOCKS5 / HTTP / MTProto)
# TG_PROXY_ENABLED=false
# TG_PROXY_TYPE=socks5
# TG_PROXY_ADDR=127.0.0.1
# TG_PROXY_PORT=1080
